# ============================================================
# ELBOLD — Development Environment Variables
#
# For LOCAL development:
#   Copy this file to .env.local and fill in the values.
#   .env.local is gitignored and will never be committed.
#
# For CLOUD development (GitHub Codespaces):
#   Do NOT create .env.local in a Codespace.
#   Set secrets in:
#   GitHub → Repository → Settings → Secrets and variables
#   → Codespaces → New repository secret
#   They are injected automatically at container startup.
#
# ⚠ STRIPE SAFETY:
#   STRIPE_SECRET_KEY must be a TEST key (sk_test_* or rk_test_*).
#   The app throws an error if a live key (sk_live_*, rk_live_*)
#   is detected when VERCEL_ENV is not "production". This prevents
#   accidental real GBP charges in local dev and Codespace.
#
# ⚠ RESEND SAFETY:
#   Emails are suppressed in non-production by default.
#   Set RESEND_DEV_OVERRIDE_EMAIL to redirect emails to your inbox.
#   Leave it unset to suppress all email sends (safe default).
#
# ⚠ SUPABASE:
#   Use a dedicated DEVELOPMENT Supabase project.
#   Never use production credentials in Codespace — the admin
#   client bypasses Row Level Security.
# ============================================================


# ============================================================
# REQUIRED — Supabase
# USE A DEV PROJECT — never production credentials in Codespace
# https://app.supabase.com → Project → Settings → API
# ============================================================

# Project URL — must start with https://
NEXT_PUBLIC_SUPABASE_URL=https://your-dev-project.supabase.co

# Anon / public key — safe to expose client-side
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — BYPASSES RLS, never expose client-side
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# ============================================================
# REQUIRED — Stripe
# ⚠ TEST KEY ONLY (sk_test_* or rk_test_*) — live keys blocked outside Vercel production
# Stripe Dashboard → Developers → API Keys → toggle Test mode
# ============================================================

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...


# ============================================================
# REQUIRED — Resend (email delivery)
# Emails are suppressed in non-production unless
# RESEND_DEV_OVERRIDE_EMAIL is set (see OPTIONAL section).
# https://resend.com/api-keys
# ============================================================

RESEND_API_KEY=re_...


# ============================================================
# REQUIRED — OpenAI (AI features)
# Required for all AI-powered features (smart plan, chat, etc.)
# https://platform.openai.com/api-keys
# ============================================================

OPENAI_API_KEY=sk-proj-...


# ============================================================
# REQUIRED — App URL
# Used for Stripe success/cancel redirects and email links.
# In Codespace: set to http://localhost:3000 for local routes.
# Stripe checkout will use this for redirect URLs.
# ============================================================

NEXT_PUBLIC_APP_URL=http://localhost:3000


# ============================================================
# OPTIONAL — Resend dev email redirect
# When set in non-production, ALL emails are redirected to
# this address instead of being suppressed. Subject lines are
# prefixed with [DEV -> original@recipient.com].
# Leave unset to suppress all emails (safe default).
# ============================================================

# RESEND_DEV_OVERRIDE_EMAIL=you@yourdomain.com


# ============================================================
# OPTIONAL — Admin access
# Comma-separated emails that can access /admin routes.
# Defaults to empty (admin routes return 403 for all users).
# ============================================================

ADMIN_EMAILS=you@yourdomain.com


# ============================================================
# OPTIONAL — Rate limiting (Upstash Redis)
# Without these, rate limiting fails open (all requests pass).
# Acceptable for Codespace; not recommended for staging.
# https://console.upstash.com
# ============================================================

# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token


# ============================================================
# OPTIONAL — Stripe subscription price IDs
# Required for vendor subscription flows to function.
# Get from Stripe Dashboard → Products (in Test mode).
# ============================================================

# STRIPE_PRO_MONTHLY_PRICE_ID=price_...
# STRIPE_PRO_YEARLY_PRICE_ID=price_...
# STRIPE_FEATURED_PRICE_ID=price_...
# STRIPE_ELITE_PRICE_MONTHLY=price_...
# STRIPE_ELITE_PRICE_YEARLY=price_...


# ============================================================
# OPTIONAL — Stripe Connect (vendor payouts)
# Kill switch: leave unset or set to "false" to disable Connect.
# Stripe Connect platform approval is pending — do not enable.
# ============================================================

# STRIPE_CONNECT_ENABLED=false
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...


# ============================================================
# OPTIONAL — Cron job authentication
# Bearer token for /api/cron/* endpoints.
# Generate with: openssl rand -hex 32
# ============================================================

# CRON_SECRET=generate-a-strong-random-secret


# ============================================================
# OPTIONAL — Push notifications (VAPID)
# All three must be set together or push is silently disabled.
# Generate keys with: npx web-push generate-vapid-keys
# WARNING: rotating keys invalidates all existing subscriptions.
# ============================================================

# NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_PRIVATE_KEY=your-vapid-private-key
# VAPID_SUBJECT=mailto:hello@elbold.com


# ============================================================
# OPTIONAL — Telegram notifications
# ============================================================

# TELEGRAM_BOT_TOKEN=your-bot-token


# ============================================================
# OPTIONAL — Sentry error tracking
# ============================================================

# SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz


# ============================================================
# DEV ONLY — Seeding and demo users
# These routes are blocked in production (VERCEL_ENV=production).
# Defaults are publicly known — set your own values to override.
# POST /api/dev/seed-e2e         guarded by SEED_SECRET
# POST /api/auth/create-demo-users  guarded by DEMO_SECRET
# ============================================================

# SEED_SECRET=your-strong-random-seed-secret
# DEMO_SECRET=your-strong-random-demo-secret
# DEMO_PASSWORD=your-strong-demo-password
# BOLD_PARTY_SEED_SECRET=your-seed-secret
